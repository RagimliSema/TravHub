{
  "name": "travhub-backend",
  "version": "1.0.0",
  "description": "TravHub REST API – Node.js, Express, MongoDB (Mongoose)",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch --watch-preserve-output server.js",
    "make-admin": "node scripts/makeAdmin.js",
    "reset-link": "node scripts/createResetLink.js",
    "seed": "node scripts/seedProducts.js",
    "reset-test-users": "node scripts/resetTestUsers.js",
    "copy-db": "node scripts/copyDatabase.js",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.2",
    "morgan": "^1.12.1",
    "nodemailer": "^10.0.13"
  }
}
