# Lokal: development | Deploy (Render və s.): production
NODE_ENV=development
# Hosting PORT-u özü verir (Render), lokal 5000
PORT=5000

# React (Vite) frontend-in ünvanı – CORS, reset linki və OAuth qayıdışı üçün.
# Vergüllə bir neçə ünvan yazmaq olar. Deploy: https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# Lokal MongoDB və ya MongoDB Atlas bağlantı ünvanı
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/travhub?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/travhub

# Avtomatik testlər üçün ayrıca baza (testlər onu silib yenidən yaradır, adı _test ilə bitməlidir)
MONGO_URI_TEST=mongodb://127.0.0.1:27017/travhub_test

# Uzun, təsadüfi sətir yazın, məs.: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Production-da nümunə dəyərlə server işə düşmür
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRE=7d

# Hosting proxy arxasındadırsa (Render, Railway): 1. Lokal: boş saxlayın
TRUST_PROXY=

# ---------- Email (şifrə sıfırlama məktubları) ----------
# Boş qalsa development-də məktub GÖNDƏRİLMİR – link backend terminalına yazılır.
# Nümunə (Gmail): SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=sizin@gmail.com,
#                 SMTP_PASS=Google "App password" (adi Gmail şifrəsi yox)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="TravHub <no-reply@travhub.local>"

# ---------- Sosial giriş (istəyə bağlı) ----------
# Backend-in öz ünvanı – OAuth redirect URL-ləri bundan qurulur. Deploy: https://your-api.onrender.com
SERVER_URL=http://localhost:5000

# Google: console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook: developers.facebook.com → My Apps → app → Facebook Login → Settings
# Valid OAuth Redirect URI: http://localhost:5000/api/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# FACEBOOK_GRAPH_VERSION=v23.0
