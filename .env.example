# Backend API-nin ünvanı (backend/ qovluğundakı Express server), sonunda /api
# Lokal:  VITE_API_URL=http://localhost:5000/api
# Deploy: hosting-in (Vercel) Environment Variables bölməsində yazılır, məs.
#         VITE_API_URL=https://your-api.onrender.com/api
# Vite bu dəyəri BUILD zamanı koda yazır – dəyişəndən sonra yenidən deploy (build) lazımdır.
VITE_API_URL=http://localhost:5000/api
